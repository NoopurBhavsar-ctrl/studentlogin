<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Portal | Login</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Anton&display=swap"
          rel="stylesheet">

    <style>
        :root {
            --yellow: #f5ef52;
            --blue: #2679f5;
            --orange: #ff5038;
            --black: #111111;
            --white: #f8f7f2;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--white);
            color: var(--black);
            font-family: 'Space Mono', monospace;
        }

        /* Navigation */
        .navbar {
            margin: 25px 4%;
            padding: 18px 22px;
            border: 3px solid var(--black);
            box-shadow: 7px 7px 0 var(--black);
        }

        .navbar-brand {
            font-family: 'Anton', sans-serif;
            font-size: 28px;
            color: var(--black);
        }

        .nav-label {
            font-weight: bold;
            font-size: 13px;
        }

        /* Main layout */
        .main-section {
            padding: 40px 4% 70px;
        }

        .hero-title {
            font-family: 'Anton', sans-serif;
            font-size: clamp(55px, 7vw, 100px);
            line-height: 0.98;
            text-transform: uppercase;
            margin-bottom: 25px;
        }

        .hero-description {
            font-size: 16px;
            font-weight: bold;
            line-height: 1.8;
            max-width: 400px;
        }

        /* Decorative block */
        .graphic-block {
            margin-top: 35px;
            min-height: 180px;
            background: var(--orange);
            border: 3px solid var(--black);
            box-shadow: 8px 8px 0 var(--black);
            padding: 25px;
            display: flex;
            align-items: end;
            justify-content: space-between;
        }

        .graphic-block h2 {
            font-family: 'Anton', sans-serif;
            font-size: 34px;
            margin: 0;
        }

        .graphic-number {
            font-size: 40px;
            font-weight: bold;
        }

        /* Login card */
        .login-card {
            border: 4px solid var(--black);
            background: var(--white);
            box-shadow: 10px 10px 0 var(--black);
        }

        .login-header {
            background: var(--blue);
            border-bottom: 4px solid var(--black);
            padding: 30px;
        }

        .login-header h2 {
            font-family: 'Anton', sans-serif;
            font-size: clamp(32px, 4vw, 48px);
            text-transform: uppercase;
            margin: 0 0 10px;
        }

        .login-header p {
            margin: 0;
            font-size: 13px;
            font-weight: bold;
        }

        .login-body {
            padding: 30px;
        }

        .form-label {
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .form-control {
            border: 3px solid var(--black);
            border-radius: 0;
            background: transparent;
            padding: 15px;
            font-family: 'Space Mono', monospace;
        }

        .form-control:focus {
            border-color: var(--blue);
            box-shadow: 4px 4px 0 var(--blue);
        }

        /* Login button */
        .btn-brutal {
            width: 100%;
            padding: 15px;
            margin-top: 10px;
            background: var(--orange);
            color: var(--black);
            border: 3px solid var(--black);
            border-radius: 0;
            box-shadow: 5px 5px 0 var(--black);
            font-family: 'Anton', sans-serif;
            font-size: 23px;
            transition: 0.15s;
        }

        .btn-brutal:hover {
            background: var(--yellow);
            color: var(--black);
            transform: translate(3px, 3px);
            box-shadow: 2px 2px 0 var(--black);
        }

        .login-footer {
            border-top: 3px solid var(--black);
            margin-top: 30px;
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            font-size: 12px;
            font-weight: bold;
        }

        .login-footer a {
            color: var(--black);
            text-decoration: underline;
        }

        .status-message {
            margin-top: 18px;
            font-size: 13px;
            font-weight: bold;
        }

        /* Mobile responsive */
        @media (max-width: 767px) {
            .navbar {
                margin: 18px 4%;
            }

            .nav-label {
                display: none;
            }

            .main-section {
                padding-top: 25px;
            }

            .hero-title {
                font-size: 60px;
            }

            .graphic-block {
                min-height: 120px;
                margin-bottom: 45px;
            }

            .login-header,
            .login-body {
                padding: 22px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar bg-white">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">STUDENT PORTAL.</a>

            <span class="nav-label">
                LEARN / GROW / ACHIEVE
            </span>

            <span class="fw-bold fs-4" aria-hidden="true">↗</span>
        </div>
    </nav>

    <!-- Main Section -->
    <main class="container-fluid main-section">
        <div class="row g-5 align-items-center">

            <!-- Left Content -->
            <section class="col-md-6">
                <h1 class="hero-title">
                    Student<br>Login<span style="color: #2679f5;">.</span>
                </h1>

                <p class="hero-description">
                    YOUR EDUCATION.<br>
                    YOUR FUTURE.<br>
                    YOUR NEXT BIG MOVE.
                </p>

                <div class="graphic-block">
                    <h2>LEVEL UP<br>YOUR FUTURE.</h2>
                    <span class="graphic-number">01/26</span>
                </div>
            </section>

            <!-- Right Login Form -->
            <section class="col-md-6">
                <div class="login-card">

                    <div class="login-header">
                        <h2>Welcome Back!</h2>
                        <p>PLEASE LOGIN TO YOUR ACCOUNT_</p>
                    </div>

                    <div class="login-body">
                        <form id="loginForm">

                            <div class="mb-4">
                                <label for="studentId"
                                       class="form-label">
                                    Student ID
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    id="studentId"
                                    placeholder="Enter your student ID"
                                    autocomplete="username"
                                    required>
                            </div>

                            <div class="mb-4">
                                <label for="password"
                                       class="form-label">
                                    Password
                                </label>

                                <input
                                    type="password"
                                    class="form-control"
                                    id="password"
                                    placeholder="Enter your password"
                                    autocomplete="current-password"
                                    required>
                            </div>

                            <button type="submit" class="btn btn-brutal">
                                LOGIN →
                            </button>

                            <p id="statusMessage"
                               class="status-message"
                               role="status"
                               aria-live="polite"></p>

                        </form>

                        <div class="login-footer">
                            <a href="#forgot-password">
                                FORGOT PASSWORD?
                            </a>

                            <a href="#signup">
                                NEW STUDENT? SIGN UP
                            </a>
                        </div>
                    </div>
                </div>

                <p class="mt-4 fw-bold small">
                    © 2026 STUDENT PORTAL — ALL RIGHTS RESERVED.
                </p>
            </section>

        </div>
    </main>

    <!-- Demo-only form interaction -->
    <script>
        document.getElementById("loginForm").addEventListener(
            "submit",
            function(event) {
                event.preventDefault();

                document.getElementById("statusMessage").textContent =
                    "Demo only: Connect a backend to authenticate your account.";
            }
        );
    </script>

</body>
</html>